# The Phase 0 foundation works without environment variables.
# Copy this file to .env.local only when a later integration needs it.

# Public, non-secret canonical site URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional future Cloudflare Turnstile integration. Leave blank until implemented.
# The site key is public; the secret key must remain server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supabase Auth. These values are public browser credentials, not service-role
# secrets. Configure Email, Google, and GitHub providers in Supabase separately.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the deployed Cloudflare Worker (no trailing slash).
NEXT_PUBLIC_CLOUD_SYNC_API_URL=
