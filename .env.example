# The Phase 0 foundation works without environment variables.
# Copy this file to .env.local only when a later integration needs it.

# Public, non-secret canonical site URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional future Cloudflare Turnstile integration. Leave blank until implemented.
# The site key is public; the secret key must remain server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
