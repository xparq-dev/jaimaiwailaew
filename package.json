{
  "name": "jaimaiwailaew",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first Thai tax preparation and estimation PWA foundation.",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pdf:fonts": "node scripts/build-pdf-font-vfs.mjs",
    "worker:dev": "wrangler dev --config workers/wrangler.jsonc --env preview",
    "worker:deploy": "wrangler deploy --config workers/wrangler.jsonc --env preview",
    "worker:deploy:preview": "wrangler deploy --config workers/wrangler.jsonc --env preview",
    "worker:deploy:production": "wrangler deploy --config workers/wrangler.jsonc --env production",
    "worker:typecheck": "tsc --noEmit -p workers/tsconfig.json",
    "prepare": "node scripts/setup-husky.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-thai": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "pdfmake": "0.3.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/pdfmake": "0.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "wrangler": "^4.135.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  }
}
